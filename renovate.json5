      matchStrings: [
        '(?<depType>deps|devDeps|peerDeps):\\s*\\[[^\\]]*\\]',
        "'(?<depName>@?[\\w-\\/]+)@(?<currentValue>[^']+)'",
      ],
      depTypeTemplate: "{{#if (equals depType 'deps')}}dependencies{{else if (equals depType 'devDeps')}}devDependencies{{else}}peerDependencies{{/if}}",
